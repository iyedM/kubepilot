# Pinned versions for the local lab. Single source of truth: sourced by the
# lab scripts and included by the Makefile. Every value here is checked by
# lab/scripts/verify-pins.sh before anything is created; a pin that does not
# resolve stops the run, it is never silently replaced.
#
# Plain KEY=value lines only (no quotes, no spaces) so that both make and
# POSIX shells can read this file.

# Tooling, downloaded into .tools/bin and checked against these sha256 sums
# (taken from the official release pages on 2026-10-19).
KIND_VERSION=v0.33.0
KIND_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KUBECTL_VERSION=v1.37.1
KUBECTL_SHA256=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8

# Default node image of kind v0.33.0, pinned by digest.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Helm charts (installed with --repo, no `helm repo add` on the host).
TEMPO_CHART_REPO=https://grafana-community.github.io/helm-charts
TEMPO_CHART_VERSION=3.2.0
PROMETHEUS_CHART_REPO=https://prometheus-community.github.io/helm-charts
PROMETHEUS_CHART_VERSION=29.37.0
OTELCOL_CHART_REPO=https://open-telemetry.github.io/opentelemetry-helm-charts
OTELCOL_CHART_VERSION=0.176.0

# Collector image: the "k8s" distribution ships the k8sattributes processor.
# Tag matches the chart's appVersion.
OTELCOL_IMAGE_REPO=otel/opentelemetry-collector-k8s
OTELCOL_IMAGE_TAG=0.162.0

# Synthetic telemetry used by lab-check, same release line as the collector.
TELEMETRYGEN_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-contrib/telemetrygen:v0.162.0
